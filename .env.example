# Mangostic Website — environment variables (placeholders only)

# Backend API base URL (no trailing slash)
# REQUIRED in production builds — no localhost fallback when NODE_ENV=production
# Used for customer orders and admin authentication
NEXT_PUBLIC_API_URL=http://localhost:5000

# WhatsApp business number — international digits only (no + or spaces)
# Example: 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Optional corporate / B2B WhatsApp line (defaults to NEXT_PUBLIC_WHATSAPP_NUMBER)
# NEXT_PUBLIC_WHATSAPP_CORPORATE_NUMBER=923001234567

# Vercel production checklist:
# - Set NEXT_PUBLIC_API_URL to your Render/Railway backend URL (https://...)
# - Set NEXT_PUBLIC_WHATSAPP_NUMBER to the live business number
# - Build command: npm run build
# - Output: Next.js (App Router) — framework preset is fine
# - Ensure backend CORS FRONTEND_URL matches this Vercel domain
